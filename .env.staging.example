# EXEMPLO APENAS. Configure os valores como Secrets no Coolify; não versionar arquivo preenchido.
DJANGO_DEBUG=0
DJANGO_USE_WHITENOISE=1
DJANGO_SECRET_KEY=GERAR_SEGREDO_EXCLUSIVO_E_FORTE
DJANGO_COLLABORATOR_ID_KEY=GERAR_SEGREDO_ESTAVEL_EXCLUSIVO_DE_STAGING
DJANGO_ALLOWED_HOSTS=homologacao.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://homologacao.exemplo.com
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO_STAGING?sslmode=require
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# Habilitar somente se o proxy confiável sobrescrever X-Forwarded-Proto.
DJANGO_USE_X_FORWARDED_PROTO=1
# Começar em zero; aumentar somente depois de validar domínio e HTTPS.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# O Realtime permanece desativado e a Conferência usa polling de contingência até configurar a chave.
SUPABASE_REALTIME_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUIR
SUPABASE_REALTIME_SIGNING_KEY_ID=KID_DA_CHAVE_PUBLICA_IMPORTADA_NO_SUPABASE
# Segredo privado: adicionar somente como Runtime Secret no Coolify; nunca versionar.
SUPABASE_REALTIME_SIGNING_PRIVATE_KEY=CONFIGURAR_PEM_ES256_PRIVADA_COM_NEWLINES_ESCAPADOS
# Opcional; default: SUPABASE_REALTIME_URL + /auth/v1
SUPABASE_REALTIME_ISSUER=https://SEU-PROJETO.supabase.co/auth/v1
